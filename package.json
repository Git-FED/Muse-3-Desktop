{
  "name": "desktop-buddy",
  "version": "0.1.0",
  "description": "Desktop Buddy \u2014 three isolated Muse sessions in one desktop window.",
  "main": "main.js",
  "author": "Git-FED",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "42.11.16",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.fedos.desktopbuddy",
    "productName": "Desktop Buddy",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/icon.icns"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Desktop-Buddy-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktop Buddy"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "Desktop-Buddy-${version}-${arch}.${ext}"
    }
  }
}
